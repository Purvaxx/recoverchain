# RecoverChain runs fully offline with zero config — every var below is optional
# for local dev. The ones marked (prod) MUST be set for any shared deployment.

# Database. Default: local SQLite file (no server needed).
# For Postgres: postgresql://user:pass@host:5432/recoverchain  (then `alembic upgrade head`)
# DATABASE_URL=sqlite:///./recoverchain.db

# (prod) API key required on mutating endpoints (X-API-Key header).
# Dev default is "test-api-key"; the app logs a warning until you override it.
# API_KEY=change-me-to-a-long-random-string

# (prod) CORS allowlist (comma-separated). Default "*" disables credentialed CORS.
# CORS_ORIGINS=https://app.example.com

# Silence the insecure-default startup warnings (throwaway envs only).
# ALLOW_INSECURE_DEFAULTS=1

# Request rate limit (per API key / client IP). Set RATE_LIMIT_ENABLED=0 to disable.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_RPM=120

# Max accepted upload size in bytes. Default 512 MiB.
# MAX_UPLOAD_BYTES=536870912

# Currency used when a dataset has no currency column.
# DEFAULT_CURRENCY=INR

# Redis is OPTIONAL — nothing on the request path uses it. Leave unset to disable.
# REDIS_URL=redis://localhost:6379/0

# ML training quality gate. Defaults: 0.55 / 200. Set to 0 to disable.
# ML_MIN_ROC_AUC=0.55
# ML_MIN_TEST_ROWS=200

# Optional real-LLM narration (off by default; app stays offline without it).
# GEMINI_API_KEY=
