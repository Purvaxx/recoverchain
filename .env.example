# docker-compose configuration. Copy to .env and fill in.

# Postgres credentials (used by both the postgres and api services).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=recoverchain

# Backend API key clients must send as X-API-Key. Use a long random string.
API_KEY=

# Explicit CORS allow-list for the API (comma-separated origins).
CORS_ORIGINS=http://localhost:5173
